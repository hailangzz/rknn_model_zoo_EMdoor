// git 提交项目标签时命令
  git tag -a v1.0 -m "版本1.0"
  git push origin v1.0  
//git 删除标签
  git tag -d v1.0
  git push origin --delete v1.0
//git显示标签信息
  git show v1.0

// git 提交项目分支时命令
  git checkout -b new_branch
  git add .
  git commit -m "提交新分支"
  git push origin new_branch

//git 合并分支时命令
  git checkout main
  git merge new_branch
  git push origin main

